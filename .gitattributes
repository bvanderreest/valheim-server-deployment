# Shell scripts and systemd units MUST be LF — CRLF makes the shebang unparseable
# ("/usr/bin/env: 'bash\r': No such file or directory"). See issue #75.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.py            text eol=lf
*.example       text eol=lf
