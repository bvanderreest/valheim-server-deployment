[Unit]
Description=Valheim Server Backup Service
After=network.target
# A oneshot that a timer drives must NOT restart itself. It used to carry
# Restart=on-failure with no limit, so a single failure became six restarts a
# minute forever: config.conf aborted under `set -u` and systemd relaunched
# this 5,884 times, writing 78,295 journal lines and never once completing a
# backup. The timer is the retry mechanism — it fires again next hour.
#
# The limit below is a backstop for a manual `systemctl start` loop, and matches
# the pattern already used by valheim-server.service.
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=oneshot
# User and ExecStart are substituted by 'deploy' — do not edit this file directly.
User=__USER__
ExecStart=__SCRIPT_DIR__/backup-automation.sh
# Deliberately NO Restart=. See the note above.
#
# A backup tars and verifies the world; on a large world that is not instant,
# but it must not run forever either.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
