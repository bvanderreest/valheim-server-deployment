# Valheim Server Management API — systemd service unit
#
# User, WorkingDirectory, ExecStart, and EnvironmentFile are substituted
# by 'deploy' — do not edit this file directly.
# Use: sudo systemctl edit valheim-api to add overrides.
#
# IMPORTANT: API is opt-in. Set API_ENABLED=true in .env before enabling.
# Enable with: sudo systemctl enable --now valheim-api

[Unit]
Description=Valheim Server Management API
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__

WorkingDirectory=__SCRIPT_DIR__

# Provision the virtualenv and install/verify dependencies before starting.
# Uses the same logic as 'api-manager.sh setup' — safe to run on every start.
ExecStartPre=__SCRIPT_DIR__/api-manager.sh setup

# Run uvicorn directly as the foreground process so systemd can track it.
ExecStart=__SCRIPT_DIR__/.venv/bin/uvicorn api.main:app \
    --host ${API_HOST} \
    --port ${API_PORT} \
    --workers 1 \
    --log-level info \
    --access-log

# IMPORTANT: --workers 1 is required. The in-memory rate limiter in auth.py
# is not shared across processes. Replace with a Redis-backed store before
# increasing workers.

Restart=on-failure
RestartSec=5

# Defaults, so a .env missing these cannot expand to an empty --host and make
# uvicorn fail with an opaque error. EnvironmentFile is applied after
# Environment, so the .env values win when present.
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8080

# API_HOST and API_PORT come from here and are expanded into ExecStart above.
# They used to be hard-coded as 127.0.0.1:8080 while .env also defined them —
# two sources of truth that disagreed, so setting API_HOST in .env silently did
# nothing. That cost an hour of 502s from a reverse proxy that could not reach
# a service the config said was listening.
EnvironmentFile=__SCRIPT_DIR__/.env

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
